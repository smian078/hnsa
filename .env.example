# NVIDIA_API_KEY: Required for NVIDIA NIM AI API calls (starts with nvapi- from build.nvidia.com).
# Can also be entered directly in the app's AI Guide panel.
NVIDIA_API_KEY=""

# NASA_API_KEY: Optional NASA Earthdata/Open API key for higher rate limits.
NASA_API_KEY=""

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

